# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Корень домена на Timeweb. Для GitHub Pages: /имя-репо/
VITE_BASE_PATH=/

# Сократ: при настроенном Supabase — Edge Function (без VPN у пользователя).
# Секрет на сервере: GEMINI_API_KEY
#
# Только прямой Gemini из браузера (часто нужен VPN в РФ):
# VITE_SOCRATES_MODE=gemini
# VITE_GEMINI_API_KEY=

# ЮKassa — только Secrets Edge Functions (не во фронт):
# YOOKASSA_SHOP_ID, YOOKASSA_SECRET_KEY, опционально SITE_URL
